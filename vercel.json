{
  "buildCommand": "npm run build:all",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/staff/login", "destination": "/staff/index.html" },
    { "source": "/staff/(.*)", "destination": "/staff/index.html" },
    { "source": "/staff",      "destination": "/staff/index.html" },
    { "source": "/(.*)",       "destination": "/index.html" }
  ]
}
